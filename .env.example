# Zerodha Kite Connect API credentials (required)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Zerodha Kite Connect access token (optional, auto-populated after login)
# KITE_ACCESS_TOKEN=your_access_token_here

# Zerodha Kite Connect redirect URL (optional, for automatic request_token capture)
# Configure this same URL in your Zerodha developer console.
# Example: http://127.0.0.1:61035/callback
# KITE_REDIRECT_URL=http://127.0.0.1:61035/callback
